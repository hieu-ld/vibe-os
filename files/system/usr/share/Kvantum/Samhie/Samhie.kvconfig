indicator.size=12

[Dock]
frame=false
interior=false
text.normal.color=#bdbec1
text.focus.color=#bdbec1
text.press.color=#bdbec1
text.toggle.color=#bdbec1
text.shadow=0

[DockTitle]
frame=false
interior=false
text.normal.color=#bdbec1
