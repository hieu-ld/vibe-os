#!/usr/bin/env bash
# In ngày hôm nay kiểu Việt: "Thứ 2, 28/09/2026" / "Chủ nhật, 04/10/2026".
# Định dạng user chốt 2026-09-28: giờ đứng trước (label riêng của hyprlock),
# ngày ghi số đủ hai chữ số + năm.
#
# Tự ghép thay vì dùng `date +%A`: máy chạy locale en_US nên %A ra "Friday".
# Cùng quy tắc với Samhie 1.0: vùng Việt Nam là do múi giờ quyết định, không
# phải ngôn ngữ hệ thống.
set -eu

weekday=$(date +%u)   # 1 = thứ Hai … 7 = Chủ nhật
if [ "$weekday" -eq 7 ]; then
    name="Chủ nhật"
else
    name="Thứ $((weekday + 1))"
fi

echo "$name, $(date +%d/%m/%Y)"
