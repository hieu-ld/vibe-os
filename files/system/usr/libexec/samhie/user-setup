#!/usr/bin/env bash
# Dựng phần riêng của Samhie cho MỘT tài khoản, ở lần đăng nhập đầu tiên:
#   1. Cấu trúc thư mục (user chốt 2026-09-29): home để cho thứ cần nhanh
#      (SSD) — chỉ còn Download cùng thư mục người dùng tự tạo (Projects…).
#      Docs/Music/Pictures/Videos nằm trong Storage, nơi lưu trữ lâu dài.
#      Không có Desktop: Hyprland không vẽ icon lên màn hình nền.
#   2. Sidebar Places của Dolphin theo bản thiết kế.
#
# Storage là Ổ RIÊNG nếu máy có: phân vùng gán vào /mnt/storage lúc cài
# (trình cài Fedora tự ghi fstab). Không có ổ đó, hoặc người dùng không ghi
# được vào nó, thì Storage là thư mục ~/Storage.
#
# Chạy bởi samhie-user-setup.service (dịch vụ systemd của user) MỖI lần đăng
# nhập, nhưng chỉ làm việc khi dấu ở ~/.local/state/samhie/user-setup còn cũ
# hơn $version. Sau đó thư mục và sidebar là của người dùng: đổi gì giữ nấy.
#
# Vì sao không dùng /etc/skel như bản 1.0: Samhie cài bằng cách cài Fedora
# Atomic rồi rebase, nên tài khoản có TRƯỚC image và không bao giờ nhận skel.
# Script này chạy được cho cả tài khoản cũ lẫn tài khoản tạo sau.
#
# KHÔNG BAO GIỜ di chuyển hay xoá dữ liệu. Thư mục cũ (Documents, Downloads…)
# chỉ bị bỏ khi RỖNG — bằng rmdir, lệnh tự từ chối thư mục có file. Có file
# bên trong thì giữ nguyên thư mục đó và tiếp tục trỏ vào nó.
set -eu

version=1

state_dir=${XDG_STATE_HOME:-$HOME/.local/state}/samhie
marker=$state_dir/user-setup
config_home=${XDG_CONFIG_HOME:-$HOME/.config}
data_home=${XDG_DATA_HOME:-$HOME/.local/share}
dirs_file=$config_home/user-dirs.dirs
places=$data_home/user-places.xbel
places_template=/usr/share/samhie/user-places.xbel.in

# ── 0. Konsole: ẩn hai thanh công cụ ────────────────────────────────────────
# Dáng "bảng đen + một dải tab" (user 2026-09-30). Thanh menu và dải tab chỉnh
# được từ /etc/xdg/konsolerc, nhưng ẩn/hiện thanh công cụ thì KDE 6 chỉ lưu
# trong khối State nhị phân của ~/.local/state/konsolestaterc — file trạng
# thái KHÔNG có bản mặc định toàn máy, nên phải ghi cho từng tài khoản.
# State dưới đây = QMainWindow::saveState() của Konsole 26.08 đo trong máy ảo,
# lật cờ "đang hiện" (byte ngay sau tên) của mainToolBar và sessionToolbar từ
# 01 sang 00; hai dock (Quick Commands, SSH) vốn đã ẩn.
# Mốc RIÊNG, không dùng $version: tài khoản đã chạy bước 1-2 cũng nhận bước
# này đúng một lần, mà bước 1-2 không chạy lại. Bật lại thanh công cụ: menu
# chuột phải hoặc Ctrl+Shift+M (thanh menu) → Settings → Toolbars Shown.
konsole_marker=$state_dir/konsole-toolbars
if [ ! -e "$konsole_marker" ] && command -v kwriteconfig6 >/dev/null; then
    kwriteconfig6 --file "${XDG_STATE_HOME:-$HOME/.local/state}/konsolestaterc" \
        --group MainWindow --key State \
        ''
    mkdir -p -- "$state_dir"
    touch -- "$konsole_marker"
    echo "Hid Konsole toolbars"
fi

done_version=0
if [ -r "$marker" ]; then
    read -r done_version < "$marker" || true
fi
case $done_version in
    ''|*[!0-9]*) done_version=0 ;;
esac
if [ "$done_version" -ge "$version" ]; then
    exit 0
fi

# /mnt là symlink sang /var/mnt trên Fedora Atomic; lấy đường dẫn thật để
# sidebar và user-dirs.dirs hiện đúng chỗ mount.
storage=$HOME/Storage
if [ -e /mnt/storage ]; then
    storage_mount=$(realpath -- /mnt/storage)
    if ! mountpoint -q -- "$storage_mount"; then
        echo "/mnt/storage is not a mount point, using $storage"
    elif [ ! -w "$storage_mount" ]; then
        echo "Cannot write to $storage_mount (fix with: sudo chown $(id -un): $storage_mount), using $storage"
    else
        storage=$storage_mount
    fi
fi

# Tên XDG  | chỗ của Samhie | chỗ mặc định khi chưa có user-dirs.dirs
#   @ = thư mục Storage, ~ = home, - = tắt (trỏ về chính home — quy ước của
#   xdg-user-dirs cho "không dùng"; Templates/Public hiếm ai dùng)
# (cột cuối là thứ Qt/GLib tự dùng khi file thiếu dòng đó — thư mục Fedora
# hay tạo sẵn, cần nhận ra để dọn nếu rỗng)
layout='DESKTOP     -          Desktop
DOWNLOAD    ~/Download Downloads
DOCUMENTS   @/Docs     Documents
TEMPLATES   -          Templates
MUSIC       @/Music    Music
PICTURES    @/Pictures Pictures
VIDEOS      @/Videos   Videos
PUBLICSHARE -          Public'

resolve() {
    case $1 in
        -) printf '%s' "$HOME" ;;
        '~'/*) printf '%s/%s' "$HOME" "${1#'~'/}" ;;
        @/*) printf '%s/%s' "$storage" "${1#@/}" ;;
    esac
}

# ── 1. Thư mục ──────────────────────────────────────────────────────────────

# File này sinh ra để `source` (xem đầu file do xdg-user-dirs ghi). Chỉ gán
# biến XDG_*_DIR; biến của script viết thường nên không đụng nhau.
if [ -r "$dirs_file" ]; then
    # shellcheck disable=SC1090
    . "$dirs_file"
fi

targets=$(while read -r _ rel _; do resolve "$rel"; echo; done <<< "$layout")

is_target() {
    printf '%s\n' "$targets" | grep -qxF -- "$1"
}

# Thư mục không tồn tại cũng tính là rỗng. $HOME thì không bao giờ rỗng.
# Chỉ có ".directory" cũng là rỗng: Plasma/Dolphin tự ghi file đó (kiểu xem,
# icon) — ~/Desktop của tài khoản Kinoite cũ có sẵn nó (đo trong máy ảo
# 2026-09-29), trước đây làm script tưởng "có file" và giữ Desktop lại.
is_empty_dir() {
    local entries
    [ "$1" != "$HOME" ] || return 1
    [ -e "$1" ] || return 0
    [ -d "$1" ] || return 1
    entries=$(ls -A -- "$1")
    [ -z "$entries" ] || [ "$entries" = .directory ]
}

# Ghi đường dẫn theo cú pháp của user-dirs.dirs: "$HOME/…" hoặc tuyệt đối.
to_dirs_value() {
    local path=$1 prefix=
    if [ "$path" = "$HOME" ]; then
        printf '$HOME'
        return
    fi
    case $path in
        "$HOME"/*) prefix='$HOME/'; path=${path#"$HOME"/} ;;
    esac
    path=${path//\\/\\\\}
    path=${path//\"/\\\"}
    path=${path//\$/\\\$}
    path=${path//\`/\\\`}
    printf '%s%s' "$prefix" "$path"
}

# Storage luôn có, kể cả khi mọi thư mục cũ đều được giữ: sidebar trỏ vào nó.
mkdir -p -- "$storage"

lines=
while read -r name rel stock; do
    var=XDG_${name}_DIR
    current=${!var:-$HOME/$stock}
    target=$(resolve "$rel")

    if [ "$current" = "$target" ]; then
        chosen=$target
    elif [ "$current" = "$HOME" ] || is_empty_dir "$current"; then
        if [ "$current" != "$HOME" ] && [ -d "$current" ] && ! is_target "$current"; then
            rm -f -- "$current/.directory"
            rmdir -- "$current" && echo "Removed empty $current"
        fi
        chosen=$target
    else
        echo "Kept $name at $current (has files)"
        chosen=$current
    fi

    mkdir -p -- "$chosen"
    lines+="XDG_${name}_DIR=\"$(to_dirs_value "$chosen")\""$'\n'
    printf -v "$var" '%s' "$chosen"
done <<< "$layout"

# Ảnh chụp màn hình (phím Print, /usr/libexec/samhie/screenshot) lưu ở đây.
# Tạo sẵn, rỗng cũng để hiện — user chốt 2026-09-29.
mkdir -p -- "$XDG_PICTURES_DIR/Screenshots"

# Giữ nguyên dòng XDG_*_DIR không chuẩn người dùng tự thêm (vd PROJECTS).
extra=
if [ -r "$dirs_file" ]; then
    known=$(printf '%s\n' "$layout" | awk '{ printf "%sXDG_%s_DIR=", (NR > 1 ? "|" : ""), $1 }')
    extra=$(grep -E '^XDG_[A-Z0-9_]+_DIR=' "$dirs_file" | grep -vE "^($known)" || true)
fi

mkdir -p -- "$config_home"
{
    echo '# Thư mục người dùng — cấu trúc Storage của Samhie. "$HOME" = không dùng.'
    echo '# Ghi bởi /usr/libexec/samhie/user-setup ở lần đăng nhập đầu; từ đó file'
    echo '# là của bạn, Samhie không ghi lại nữa — sửa thẳng ở đây, rồi đăng nhập lại.'
    printf '%s' "$lines"
    if [ -n "$extra" ]; then
        printf '%s\n' "$extra"
    fi
} > "$dirs_file.tmp"
mv -f -- "$dirs_file.tmp" "$dirs_file"

# ── 2. Sidebar Places của Dolphin ───────────────────────────────────────────

# file:// URL với mã hoá phần trăm từng byte (tên thư mục có dấu cách, chữ
# Việt, & …). Kết quả chỉ còn ký tự an toàn nên chèn thẳng vào XML được.
file_url() {
    local LC_ALL=C path=$1 out= c i
    for ((i = 0; i < ${#path}; i++)); do
        c=${path:i:1}
        case $c in
            [A-Za-z0-9/._~-]) out+=$c ;;
            *) printf -v c '%%%02X' "'$c"; out+=$c ;;
        esac
    done
    printf 'file://%s' "$out"
}

if [ -r "$places_template" ]; then
    # File cũ (vd Plasma của Kinoite tự tạo trước khi rebase) cất sang bên
    # cạnh chứ không xoá. Không đè bản cất nếu đã có.
    if [ -e "$places" ] && [ ! -e "$places.before-samhie" ]; then
        mv -- "$places" "$places.before-samhie"
        echo "Saved old Dolphin places as $places.before-samhie"
    fi

    xbel=$(< "$places_template")
    # Phần thay thế để trong ngoặc kép: bash 5.2+ coi `&` không trích dẫn là
    # "chuỗi vừa khớp" (patsub_replacement).
    xbel=${xbel//@HOME_URL@/"$(file_url "$HOME")"}
    xbel=${xbel//@STORAGE_URL@/"$(file_url "$storage")"}
    xbel=${xbel//@DOWNLOAD_URL@/"$(file_url "$XDG_DOWNLOAD_DIR")"}

    mkdir -p -- "$data_home"
    printf '%s\n' "$xbel" > "$places.tmp"
    mv -f -- "$places.tmp" "$places"
    echo "Wrote Dolphin places to $places"
fi

mkdir -p -- "$state_dir"
echo "$version" > "$marker"
