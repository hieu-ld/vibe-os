# Mở file bằng app nào — mặc định của Samhie.
#
# Nhấp đúp file chữ → Kate (KWrite bỏ khỏi image 2026-10-12; trước đó KWrite
# mở file chữ). File .desktop của Kate tự khai text/plain và inode/directory.
# (Trước 2026-10-12 có khối [Added Associations] khai thêm VS Code — .desktop
# của Microsoft chỉ khai application/x-code-workspace; VS Code đã gỡ khỏi image.)
#
# Ở /etc/xdg vì KService 6.30 đọc mimeapps.list trong MỌI thư mục cấu hình,
# bản hệ thống trước rồi bản người dùng sau (src/sycoca/kmimeassociations.cpp) —
# nên người dùng đổi app mặc định thì ~/.config/mimeapps.list của họ thắng.
#
# text/plain phủ luôn các kiểu "con" của nó (.conf, .sh, .py, .json…) — KService
# tự tính kế thừa kiểu MIME.
#
# PDF → Edge (2026-10-24, Okular bỏ khỏi danh sách cài sẵn — user chọn). Đo
# máy thật: chỉ Edge và Okular (Flatpak) khai application/pdf. Ai tự cài lại
# Okular thì đặt nó làm mặc định trong ~/.config/mimeapps.list.
#
# Ảnh → Gwenview (2026-10-25). Máy thật: nhấp đúp ảnh trong Dolphin mở SWAPPY
# (thành chụp vùng màn hình). swappy.desktop của Fedora khai image/png +
# image/jpeg, Edge khai gif/jpeg/png/webp; không có dòng mặc định thì KService
# chọn swappy dù Gwenview có InitialPreference=8. Đo (XDG_CONFIG_DIRS + cache
# riêng, kioclient exec ảnh .jpeg): trước → swappy, sau → gwenview. Danh sách
# dưới = mọi image/* trong org.kde.gwenview.desktop 26.08.
# Bỏ swappy khỏi "Mở bằng" ảnh: Exec của nó (sh -c "…\\$@…") KIO dịch sai
# → luôn lỗi cú pháp (journal: syntax error near unexpected token `else').

[Default Applications]
text/plain=org.kde.kate.desktop
inode/directory=org.kde.dolphin.desktop
application/pdf=com.microsoft.Edge.desktop
image/avif=org.kde.gwenview.desktop
image/gif=org.kde.gwenview.desktop
image/heif=org.kde.gwenview.desktop
image/jpeg=org.kde.gwenview.desktop
image/jxl=org.kde.gwenview.desktop
image/png=org.kde.gwenview.desktop
image/bmp=org.kde.gwenview.desktop
image/x-eps=org.kde.gwenview.desktop
image/x-icns=org.kde.gwenview.desktop
image/x-ico=org.kde.gwenview.desktop
image/x-portable-bitmap=org.kde.gwenview.desktop
image/x-portable-graymap=org.kde.gwenview.desktop
image/x-portable-pixmap=org.kde.gwenview.desktop
image/x-xbitmap=org.kde.gwenview.desktop
image/x-xpixmap=org.kde.gwenview.desktop
image/tiff=org.kde.gwenview.desktop
image/x-psd=org.kde.gwenview.desktop
image/x-webp=org.kde.gwenview.desktop
image/webp=org.kde.gwenview.desktop
image/x-tga=org.kde.gwenview.desktop
image/x-xcf=org.kde.gwenview.desktop
image/openraster=org.kde.gwenview.desktop
image/svg+xml=org.kde.gwenview.desktop
image/svg+xml-compressed=org.kde.gwenview.desktop

[Removed Associations]
image/png=swappy.desktop
image/jpeg=swappy.desktop
