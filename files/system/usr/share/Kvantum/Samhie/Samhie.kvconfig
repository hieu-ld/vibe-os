# SINH TỰ ĐỘNG từ theme/palette.toml bởi tools/gen-theme.py — đừng sửa tay.
# Theme Kvantum Samhie (bản tối). Phần tử vẽ: Samhie.svg cùng thư mục.

[%General]
author=Samhie
comment=Samhie — SINH TỰ ĐỘNG từ theme/palette.toml bởi tools/gen-theme.py — đừng sửa tay.
x11drag=menubar_and_primary_toolbar
composite=true
translucent_windows=true
reduce_window_opacity=10
reduce_menu_opacity=0
blurring=false
popup_blurring=false
menu_shadow_depth=0
tooltip_shadow_depth=0
no_inactiveness=true
animate_states=true
attach_active_tab=true
left_tabs=true
center_doc_tabs=false
center_normal_tabs=false
joined_inactive_tabs=false
no_active_tab_separator=true
active_tab_overlap=0
embedded_tabs=false
spread_menuitems=false
spread_header=true
scroll_arrows=false
transient_scrollbar=true
scrollbar_in_view=true
scroll_width=8
scroll_min_extent=36
slider_width=4
slider_handle_width=16
slider_handle_length=16
check_size=16
progressbar_thickness=6
splitter_width=1
small_icon_size=16
large_icon_size=32
button_icon_size=16
toolbar_icon_size=24
toolbar_interior_spacing=8
toolbar_item_spacing=4
combo_as_lineedit=true
combo_menu=true
square_combo_button=false
inline_spin_indicators=true
vertical_spin_indicators=false
menu_separator_height=9
dialog_button_layout=0
submenu_overlap=0

[GeneralColors]
window.color=#262626
base.color=#171717
alt.base.color=#171717
button.color=#262626
light.color=#393939
mid.light.color=#393939
dark.color=#0a0a0a
mid.color=#262626
shadow.color=#0a0a0a
highlight.color=#006a80
inactive.highlight.color=#006a80
text.color=#bdbec1
window.text.color=#bdbec1
button.text.color=#bdbec1
disabled.text.color=#8f8f8f
tooltip.text.color=#bdbec1
highlight.text.color=#f6f6f6
link.color=#5dc5d6
link.visited.color=#a082c8
progress.indicator.text.color=#bdbec1

[Hacks]
transparent_dolphin_view=true
transparent_ktitle_label=true
transparent_menutitle=true
respect_darkness=true
no_selection_tint=true
tint_on_mouseover=0
disabled_icon_opacity=50
normal_default_pushbutton=true
iconless_pushbutton=false
blur_translucent=false

[PanelButtonCommand]
frame=true
interior=true
frame.element=button
interior.element=button
frame.top=1
frame.bottom=1
frame.left=8
frame.right=8
frame.expansion=16
indicator.element=arrow
indicator.size=12
text.normal.color=#bdbec1
text.focus.color=#bdbec1
text.press.color=#bdbec1
text.toggle.color=#bdbec1
text.shadow=0
text.margin.top=0
text.margin.bottom=0
text.margin.left=8
text.margin.right=8
text.iconspacing=6

[PanelButtonTool]
inherits=PanelButtonCommand
frame.element=tbutton
interior.element=tbutton
frame.top=0
frame.bottom=0
frame.left=4
frame.right=4
frame.expansion=16
indicator.element=tarrow
indicator.size=0
text.margin.top=0
text.margin.bottom=0
text.margin.left=2
text.margin.right=2

[ToolbarButton]
inherits=PanelButtonTool

[DropDownButton]
inherits=PanelButtonCommand
indicator.element=arrow-down

[IndicatorArrow]
indicator.element=arrow
indicator.size=12

[IndicatorSpinBox]
inherits=PanelButtonCommand
indicator.element=arrow
indicator.size=12
frame=false
interior=false

[ComboBox]
inherits=PanelButtonCommand

[ToolbarComboBox]
inherits=ComboBox

[LineEdit]
inherits=PanelButtonCommand
frame.element=lineedit
interior.element=lineedit
frame.top=1
frame.bottom=1
frame.left=10
frame.right=10
frame.expansion=20
text.margin.left=4
text.margin.right=4

[ToolbarLineEdit]
inherits=LineEdit

[RadioButton]
inherits=PanelButtonCommand
frame=false
interior.element=radio

[CheckBox]
inherits=PanelButtonCommand
frame=false
interior.element=checkbox

[Focus]
frame=true
frame.element=focus
interior=false
frame.top=2
frame.bottom=2
frame.left=2
frame.right=2

[GenericFrame]
frame=true
interior=false
frame.element=common
interior.element=common
frame.top=8
frame.bottom=8
frame.left=8
frame.right=8
text.normal.color=#bdbec1
text.focus.color=#bdbec1
text.press.color=#bdbec1
text.toggle.color=#bdbec1
text.shadow=0

[GroupBox]
inherits=GenericFrame

[TabFrame]
inherits=GenericFrame
frame=true
frame.element=tabframe
interior.element=tabframe
frame.top=8
frame.bottom=8
frame.left=8
frame.right=8

[TabBarFrame]
frame=false
interior=false

[Tab]
inherits=PanelButtonCommand
frame=true
interior=true
frame.element=tab
interior.element=tab
frame.top=0
frame.bottom=0
frame.left=12
frame.right=12
frame.expansion=24
indicator.element=tab
indicator.size=16
text.normal.color=#bdbec1
text.focus.color=#bdbec1
text.press.color=#bdbec1
text.toggle.color=#bdbec1
text.shadow=0
text.margin.top=0
text.margin.bottom=0
text.margin.left=0
text.margin.right=0

[ToolboxTab]
inherits=PanelButtonCommand

[ItemView]
inherits=PanelButtonCommand
frame.element=itemview
interior.element=itemview
frame.top=1
frame.bottom=1
frame.left=4
frame.right=4
frame.expansion=20
text.toggle.color=#f6f6f6
text.press.color=#f6f6f6
text.margin.top=0
text.margin.bottom=0
text.margin.left=0
text.margin.right=0

[HeaderSection]
inherits=PanelButtonCommand
frame.element=header
interior.element=header
frame.top=1
frame.bottom=1
frame.left=1
frame.right=1
text.margin.left=6
text.margin.right=6

[Menu]
inherits=PanelButtonCommand
frame.element=menu
interior.element=menu
frame.top=10
frame.bottom=10
frame.left=10
frame.right=10

[MenuItem]
inherits=PanelButtonCommand
frame.element=menuitem
interior.element=menuitem
frame.top=1
frame.bottom=1
frame.left=4
frame.right=4
frame.expansion=12
text.focus.color=#f6f6f6
text.toggle.color=#f6f6f6
text.press.color=#f6f6f6
indicator.element=arrow
text.margin.top=0
text.margin.bottom=0
text.margin.left=4
text.margin.right=4

[MenuBar]
frame=false
interior=false

[MenuBarItem]
inherits=PanelButtonCommand
frame.element=menubaritem
interior.element=menubaritem
frame.top=6
frame.bottom=6
frame.left=6
frame.right=6

[ToolTip]
inherits=GenericFrame
interior=true
frame.element=tooltip
interior.element=tooltip
frame.top=1
frame.bottom=1
frame.left=6
frame.right=6
frame.expansion=12
text.margin.top=0
text.margin.bottom=0
text.margin.left=6
text.margin.right=6

[Scrollbar]
inherits=PanelButtonCommand
indicator.size=0
frame=false
interior=false

[ScrollbarGroove]
frame=false
interior=false
frame.element=scrollbargroove
interior.element=scrollbargroove
frame.top=3
frame.bottom=3
frame.left=3
frame.right=3

[ScrollbarSlider]
frame=true
interior=true
frame.element=scrollbarslider
interior.element=scrollbarslider
frame.top=3
frame.bottom=3
frame.left=3
frame.right=3
indicator.element=grip
indicator.size=0

[ScrollbarTransientSlider]
inherits=ScrollbarSlider

[Slider]
frame=true
interior=true
frame.element=slider
interior.element=slider
frame.top=2
frame.bottom=2
frame.left=2
frame.right=2

[SliderCursor]
frame=false
interior=true
interior.element=slidercursor

[Progressbar]
inherits=PanelButtonCommand
frame.element=progress
interior.element=progress
frame.top=3
frame.bottom=3
frame.left=3
frame.right=3
text.margin=0

[ProgressbarContents]
frame=true
interior=true
frame.element=progress-pattern
interior.element=progress-pattern
frame.top=3
frame.bottom=3
frame.left=3
frame.right=3

[TreeExpander]
frame=false
interior=false
indicator.element=tree
indicator.size=12

[Splitter]
frame=false
interior=true
interior.element=splitter
indicator.element=splitter-grip
indicator.size=0

[Toolbar]
frame=false
interior=false
indicator.element=toolbar
indicator.size=0
text.margin=0
text.normal.color=#bdbec1
text.focus.color=#bdbec1
text.press.color=#bdbec1
text.toggle.color=#bdbec1
text.shadow=0

[SizeGrip]
frame=false
interior=false
