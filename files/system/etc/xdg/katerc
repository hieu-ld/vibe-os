# Mặc định toàn máy của Kate (Fedora không có file này). Người dùng đè trong
# ~/.config/katerc (Kate tự ghi vào đó). Bố cục kiểu VS Code (user 2026-10-10)
# chia ba chỗ vì Kate cất mỗi thứ một nơi:
#   - file này: tuỳ chọn chung (khoá đọc ở mã Kate 26.08.1, ghi chú từng dòng)
#   - files/scripts/kate-ui.sh: thanh công cụ (file menu kateui.rc)
#   - user-setup bước 0h: panel nào nằm bên nào + bật plugin terminal-thành-tab
#     — nằm trong file PHIÊN (~/.local/share/kate/anonymous.katesession), loại
#     file không có bản mặc định toàn máy (KConfig::SimpleConfig).

[General]
# Khung Output dưới đáy KHÔNG tự bật lên (mặc định: bật khi có lỗi — máy ảo
# user thấy nó mở sẵn, đầy cảnh báo "không tìm thấy pylsp/clangd"). Số đếm
# lỗi vẫn hiện trên nút Diagnostics. 0 = Never (kateconfigdialog.cpp).
Show output view for message type=0

# Thanh menu ẩn — mọi menu nằm trong nút ☰ cuối hàng tab (plugin samhiekate,
# bản phác Figma của user 2026-10-10). Ctrl+M hiện lại. Tài khoản cũ: user-setup 0i.
Show Menu Bar=false

[Shortcuts]
# Bật/tắt khung Output (nhật ký của Kate — LSP báo lỗi, PATH…; user
# 2026-10-11: ẩn, lâu lâu mở xem). Kate không gán phím mặc định; đọc ở
# GUIClient::registerToolView (katemdi.cpp 26.08.1), nhóm [Shortcuts] của
# katerc. Ctrl+Shift+Y: Kate/KTextEditor 26.08.1 chưa dùng (đã dò mã), VS Code
# dùng cho khung dưới Debug Console. Esc vẫn đóng khung (có sẵn trong Kate).
kate_mdi_toolview_output=Ctrl+Shift+Y

[lspclient]
# Máy chủ ngôn ngữ có sẵn trong image (recipes/common.yml, qmlls.sh) chạy luôn,
# không hộp thoại "Do you want the LSP server to be started?" lần đầu mở file.
# Kate so ĐÚNG cả dòng lệnh (đường dẫn đầy đủ + tham số, lspclientplugin.cpp
# 26.08.1) — dự án nào tự khai lệnh khác thì Kate vẫn hỏi như thường.
# Ghi cả /usr/sbin: đường dẫn là thứ Kate tìm thấy ĐẦU TIÊN trong PATH, và
# /usr/sbin chỉ là symlink tới bin (Fedora gộp sbin) — PATH có sbin đứng trước
# (container thử 2026-10-12) thì Kate thấy /usr/sbin/pylsp. Cùng một file.
AllowedServerCommandLines=/usr/bin/pylsp --check-parent-process,/usr/sbin/pylsp --check-parent-process,/usr/bin/qmlls,/usr/sbin/qmlls

[KTextEditor Renderer]
# Theme màu vùng code: Samhie (sinh từ theme/palette.toml — nền = thẻ cây
# Projects, trong 90% như cửa sổ; màu cú pháp của Breeze Dark). Kate mặc định
# TỰ chọn theme theo bảng màu app (khớp đúng màu nền Base, không có thì Breeze
# Dark) — theme Samhie có nền trong nên không bao giờ khớp → tắt tự chọn.
# Khoá đọc ở KateRendererConfig (kateconfig.cpp, KTextEditor 6.30.0).
Auto Color Theme Selection=false
Color Theme=Samhie
# Khoảng cách dòng code 28px (user 2026-10-12; VS Code của user để 32): font
# Hack 11pt cao 18px (đo máy ảo) × 1,556 = 28 (KateRenderer làm tròn xuống).
Line Height Multiplier=1.556

[KTextEditor View]
# Minimap bên phải vùng code rộng hơn mặc định 60px (user 2026-10-12: "rộng
# ra 1 xíu"). Khoá đọc ở KateViewConfig (kateconfig.cpp, KTextEditor 6.30.0).
Scroll Bar Mini Map Width=72
# Thanh trạng thái bỏ hai ô (rà Kate đợt 1, user 2026-10-12):
#   INSERT  bấm nhầm là lật sang OVERWRITE (gõ đè chữ) — nút ẩn dễ lỡ tay.
#           Phím Insert vẫn lật được; lúc gõ đè, con trỏ chữ thành ô đặc.
#   en_US   từ điển kiểm chính tả — repo chỉ code, ô này không dùng tới.
# Cùng KateViewConfig. Kate chỉ ghi cả nhóm này vào ~/.config/katerc khi người
# dùng đổi cấu hình trong Kate — tài khoản đã đổi thì giữ giá trị lúc đó.
Show Statusbar Input Mode=false
Show Statusbar Dictionary=false
