#!/bin/bash
# S-bot — trợ lý AI chạy trên máy (giai đoạn 6, 2026-10-26). Khung chat là
# quickshell/assistant/Assistant.qml; script này lo phần chạy nền:
#
#   assistant serve          (samhie-assistant.service gọi) chạy model bằng
#                            RamaLama trên 127.0.0.1:$PORT, có khoá API
#   assistant status         "ready" | "missing" (chưa tải model)
#   assistant pull           tải model
#   assistant tool TÊN JSON  công cụ CHỈ ĐỌC cho model: read_journal,
#                            failed_services, find_files
#
# Khoá API: llama-server trả CORS bằng chính Origin gửi tới, không khoá thì
# trang web nào trong trình duyệt cũng gọi được model (đo 2026-10-26). Khoá
# ngẫu nhiên nằm trong $state (0700), đưa vào container bằng biến môi trường
# (không lộ trong danh sách tiến trình); khung chat đọc file header cho curl.
#
# SELinux: chạy --selinux true (container_t). RamaLama mặc định TẮT SELinux
# để với tới card NVIDIA; Samhie cho riêng thiết bị card bằng
# /usr/share/selinux/packages/samhie/samhie-gpu-container.cil.
set -u
# Mẫu kiểm đối số `[A-Za-z]` theo locale người dùng khớp cả `é`, `ａ` (đo) →
# so theo mã ký tự.
export LC_ALL=C.UTF-8

MODEL=${SAMHIE_ASSISTANT_MODEL:-ollama://qwen3.5:9b}
PORT=8083
NAME=samhie-assistant
state=${XDG_STATE_HOME:-$HOME/.local/state}/samhie/assistant

make_key() {
    mkdir -p -m 0700 "$state"
    if [ ! -s "$state/key" ]; then
        (umask 077
         head -c 32 /dev/urandom | base64 | tr -d '/+=\n' > "$state/key"
         printf 'Authorization: Bearer %s\n' "$(cat "$state/key")" > "$state/header")
    fi
}

serve() {
    make_key
    LLAMA_API_KEY=$(cat "$state/key")
    export LLAMA_API_KEY
    # Container sót lại từ lần trước (máy tắt ngang) giữ tên → serve lỗi.
    podman rm -f "$NAME" >/dev/null 2>&1
    # -c 32768: mặc định lấy ngữ cảnh tối đa của model (qwen3.5: 171k) → 10,7
    # GB VRAM; 32k → 6,3 GB (đo). --pull missing: không hỏi kho image mỗi lần
    # mở (chậm, hỏng khi mất mạng); RamaLama lên bản mới thì tag image đổi →
    # tự tải bản mới. --log-driver passthrough: chữ của llama-server đi thẳng
    # ra stdout của dịch vụ; mặc định (journald) podman ghi một bản nữa → mỗi
    # dòng hai lần trong journal (đo).
    exec ramalama serve --name "$NAME" --webui off --selinux true \
        --pull missing --env LLAMA_API_KEY --thinking false \
        --engine-args "--log-driver passthrough" \
        -p "$PORT" -c 32768 "$MODEL"
}

status() {
    # `ramalama list` ghi tên đầy đủ: ollama://library/qwen3.5:9b
    if ramalama list --json 2>/dev/null | grep -qF "/${MODEL##*/}\""; then
        echo ready
    else
        echo missing
    fi
}

# ── Công cụ chỉ đọc ────────────────────────────────────────────────────────
# Đối số là JSON do model viết — coi là dữ liệu lạ: kiểm từng trường bằng
# mẫu chặt rồi mới đưa vào lệnh (truyền thẳng làm đối số, không qua shell).
# Kết quả cắt ngắn: model chỉ có 32k ngữ cảnh.
field() {
    # field JSON TÊN → giá trị chuỗi (rỗng nếu không có / không phải chuỗi)
    python3 -I -c 'import json,sys
try:
    v = json.loads(sys.argv[1]).get(sys.argv[2], "")
    print(v if isinstance(v, str) else "")
except Exception:
    print("")' "$1" "$2"
}

clip() { tail -n "${1:-80}" | cut -c1-300 | tail -c 8000; }

tool_read_journal() {
    local unit priority since args
    unit=$(field "$1" unit)
    priority=$(field "$1" priority)
    since=$(field "$1" since)
    case $priority in emerg|alert|crit|err|warning|notice|info) ;; *) priority=warning ;; esac
    [[ $since =~ ^[A-Za-z0-9\ :.-]{1,40}$ ]] || since=today
    args=(--no-pager -o json -p "$priority" --since "$since")
    if [ -n "$unit" ]; then
        [[ $unit =~ ^[A-Za-z0-9@._:-]{1,80}$ ]] || { echo "invalid unit name"; return; }
        args+=(-u "$unit")
    fi
    journalctl "${args[@]}" 2>/dev/null | python3 -I -c "$journal_py" "$priority"
    echo "(end of log)"
}

# Đọc journal dạng JSON rồi tự in, vì dòng chữ của journalctl không lọc chắc được:
# - Bỏ dòng của chính S-bot theo trường journald đặt (_SYSTEMD_USER_UNIT):
#   dịch vụ, hoặc container của nó (libpod-….scope, tên samhie-assistant do
#   SyslogIdentifier của dịch vụ) — không theo chữ trong dòng.
# - Dòng lặp gộp thành một "(×N)", lỗi (err trở lên) in trước: chương trình
#   ghi tràn log không đẩy mất lỗi thật khỏi 80 dòng.
# - Ký tự điều khiển/xuống dòng trong tin → khoảng trắng: tin không giả được
#   "(end of log)" hay dòng mới.
# - Lệnh sudo (COMMAND=…) ẩn đối số: có khi chứa mật khẩu/token.
# - Đánh dấu "every boot" (lần khởi động trước cũng có) và "early boot" (từ
#   initrd, trước khi vào hệ thống thật — nhận ra bằng tên máy "fedora" mặc
#   định của initrd khác tên máy thật): model 9B kể mọi lỗi khởi động quen
#   thuộc như sự cố mới rồi tự bịa nguyên nhân (user 2026-10-26).
journal_py='
import json, re, socket, subprocess, sys, time
from collections import OrderedDict
def text(v):
    if isinstance(v, list):
        v = bytes(x for x in v if isinstance(x, int) and 0 <= x < 256).decode("utf-8", "replace")
    return v if isinstance(v, str) else ""
def key_of(e):
    ident = text(e.get("SYSLOG_IDENTIFIER")) or text(e.get("_COMM")) or "?"
    msg = re.sub(r"[\x00-\x1f\x7f]+", " ", text(e.get("MESSAGE"))).strip()[:300]
    return ident, msg, (ident, re.sub(r"\d+", "#", msg))
prev = set()
try:
    out = subprocess.run(["journalctl", "-b", "-1", "-p", sys.argv[1], "-o", "json",
                          "--output-fields=MESSAGE,SYSLOG_IDENTIFIER,_COMM"],
                         capture_output=True, text=True, timeout=10).stdout
    for line in out.splitlines():
        prev.add(key_of(json.loads(line))[2])
except Exception:
    pass
try:
    this_boot = open("/proc/sys/kernel/random/boot_id").read().strip().replace("-", "")
except Exception:
    this_boot = ""
host = socket.gethostname()
seen = OrderedDict()
for line in sys.stdin:
    try:
        e = json.loads(line)
    except Exception:
        continue
    unit = text(e.get("_SYSTEMD_USER_UNIT"))
    if unit == "samhie-assistant.service" or (
            unit.startswith("libpod-") and text(e.get("SYSLOG_IDENTIFIER")) == "samhie-assistant"):
        continue
    ident, msg, key = key_of(e)
    if ident == "sudo":
        msg = re.sub(r"COMMAND=.*", "COMMAND=(hidden)", msg)
    try:
        prio = int(text(e.get("PRIORITY")) or 6)
        t = time.strftime("%b %d %H:%M:%S", time.localtime(int(text(e.get("__REALTIME_TIMESTAMP"))) / 1e6))
    except Exception:
        prio, t = 6, "?"
    boot = text(e.get("_BOOT_ID"))
    early = host not in ("fedora", "localhost") and text(e.get("_HOSTNAME")) == "fedora"
    n, boots, was_early = seen.pop(key, (0, set(), False))[:3]
    boots = boots | {boot}
    if boot == this_boot and key in prev:
        boots = boots | {"prev"}
    seen[key] = (n + 1, boots, was_early or early, prio, t, ident, msg)
def fit(rows, budget):
    # Dòng mới nhất trước, tới khi hết chỗ; in lại theo thứ tự thời gian.
    out = []
    for n, boots, early, prio, t, ident, msg in reversed(rows):
        tags = ([f"x{n}"] if n > 1 else []) + (["every boot"] if len(boots) > 1 else []) \
            + (["early boot"] if early else [])
        s = f"{t} {ident}: {msg}" + (" (" + ", ".join(tags) + ")" if tags else "")
        if len(out) >= 80 or budget < len(s) + 1:
            break
        budget -= len(s) + 1
        out.append(s)
    return out[::-1]
# Mô hình chỉ có 32k ngữ cảnh: tối đa ~8000 ký tự, lỗi được tối đa một nửa.
rows = list(seen.values())
errors = fit([r for r in rows if r[3] <= 3], 4000)
rest = fit([r for r in rows if r[3] > 3], 8000 - sum(len(s) + 1 for s in errors))
if errors and rest:
    print("Errors:", *errors, "Other lines:", *rest, sep="\n")
elif errors or rest:
    print(*(errors or rest), sep="\n")
'

tool_failed_services() {
    echo "System services that failed:"
    systemctl --failed --no-legend --plain 2>&1 | clip 40
    echo "User services that failed:"
    systemctl --user --failed --no-legend --plain 2>&1 | clip 40
}

tool_find_files() {
    local pattern roots=("$HOME")
    pattern=$(field "$1" pattern)
    [[ $pattern =~ ^[^/]{1,64}$ ]] || { echo "pattern must be a file name part, no slashes"; return; }
    [ -d /var/mnt/storage ] && roots+=(/var/mnt/storage)
    # Bỏ thư mục ẩn (cấu hình, bộ đệm, thùng rác…) — tìm file người dùng.
    # -print0 + thay xuống dòng trong tên bằng "?": tên file không giả được
    # dòng kết quả hay "(end of results…)".
    find "${roots[@]}" -xdev \( -name '.*' -prune \) -o -iname "*$pattern*" -print0 2>/dev/null |
        head -z -n 50 | tr '\n\0' '?\n' | sed "s|^$HOME|~|"
    echo "(end of results, at most 50)"
}

case "${1:-}" in
    serve) serve ;;
    status) status ;;
    pull) exec ramalama pull "$MODEL" ;;
    key) make_key ;;
    tool)
        case "${2:-}" in
            read_journal|failed_services|find_files) "tool_$2" "${3:-"{}"}" ;;
            *) echo "unknown tool: ${2:-}" ;;
        esac ;;
    *) echo "usage: assistant serve|status|pull|key|tool NAME JSON" >&2; exit 2 ;;
esac
