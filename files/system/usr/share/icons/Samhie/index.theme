[Icon Theme]
Name=Samhie
Comment=Icon overrides for Samhie, everything else falls back to Breeze Dark
Inherits=breeze-dark,breeze,hicolor
FollowsColorScheme=true
Directories=actions/scalable,apps/scalable,devices/scalable,places/16,places/scalable,status/scalable

[actions/scalable]
Size=22
Type=Scalable
MinSize=8
MaxSize=512
Context=Actions

[apps/scalable]
Size=22
Type=Scalable
MinSize=8
MaxSize=512
Context=Applications

[devices/scalable]
Size=22
Type=Scalable
MinSize=8
MaxSize=512
Context=Devices

[places/16]
Size=16
Type=Fixed
Context=Places

[places/scalable]
Size=22
Type=Scalable
MinSize=8
MaxSize=512
Context=Places

[status/scalable]
Size=22
Type=Scalable
MinSize=8
MaxSize=512
Context=Status
