#!/usr/bin/env bash
# Dựng phần riêng của Samhie cho MỘT tài khoản, ở lần đăng nhập đầu tiên:
#   1. Cấu trúc thư mục (user chốt 2026-09-29): home để cho thứ cần nhanh
#      (SSD) — chỉ còn Download cùng thư mục người dùng tự tạo (Projects…).
#      Docs/Music/Pictures/Videos nằm trong Storage, nơi lưu trữ lâu dài.
#      Không có Desktop: Hyprland không vẽ icon lên màn hình nền.
#   2. Sidebar Places của Dolphin theo bản thiết kế.
#
# Storage là Ổ RIÊNG nếu máy có: phân vùng gán vào /mnt/storage lúc cài
# (trình cài Fedora tự ghi fstab). Không có ổ đó, hoặc người dùng không ghi
# được vào nó, thì Storage là thư mục ~/Storage.
#
# Chạy bởi samhie-user-setup.service (dịch vụ systemd của user) MỖI lần đăng
# nhập, nhưng chỉ làm việc khi dấu ở ~/.local/state/samhie/user-setup còn cũ
# hơn $version. Sau đó thư mục và sidebar là của người dùng: đổi gì giữ nấy.
#
# Vì sao không dùng /etc/skel như bản 1.0: Samhie cài bằng cách cài Fedora
# Atomic rồi rebase, nên tài khoản có TRƯỚC image và không bao giờ nhận skel.
# Script này chạy được cho cả tài khoản cũ lẫn tài khoản tạo sau.
#
# KHÔNG BAO GIỜ di chuyển hay xoá dữ liệu. Thư mục cũ (Documents, Downloads…)
# chỉ bị bỏ khi RỖNG — bằng rmdir, lệnh tự từ chối thư mục có file. Có file
# bên trong thì giữ nguyên thư mục đó và tiếp tục trỏ vào nó.
set -eu

version=1

state_dir=${XDG_STATE_HOME:-$HOME/.local/state}/samhie
marker=$state_dir/user-setup
config_home=${XDG_CONFIG_HOME:-$HOME/.config}
data_home=${XDG_DATA_HOME:-$HOME/.local/share}
dirs_file=$config_home/user-dirs.dirs
places=$data_home/user-places.xbel
places_template=/usr/share/samhie/user-places.xbel.in

# ── 0. Konsole: ẩn hai thanh công cụ ────────────────────────────────────────
# Dáng "bảng đen + một dải tab" (user 2026-09-30). Thanh menu và dải tab chỉnh
# được từ /etc/xdg/konsolerc, nhưng ẩn/hiện thanh công cụ thì KDE 6 chỉ lưu
# trong khối State nhị phân của ~/.local/state/konsolestaterc — file trạng
# thái KHÔNG có bản mặc định toàn máy, nên phải ghi cho từng tài khoản.
# State dưới đây = QMainWindow::saveState() của Konsole 26.08 đo trong máy ảo,
# lật cờ "đang hiện" (byte ngay sau tên) của mainToolBar và sessionToolbar từ
# 01 sang 00; hai dock (Quick Commands, SSH) vốn đã ẩn.
# Mốc RIÊNG, không dùng $version: tài khoản đã chạy bước 1-2 cũng nhận bước
# này đúng một lần, mà bước 1-2 không chạy lại. Bật lại thanh công cụ: menu
# chuột phải hoặc Ctrl+Shift+M (thanh menu) → Settings → Toolbars Shown.
konsole_marker=$state_dir/konsole-toolbars
if [ ! -e "$konsole_marker" ] && command -v kwriteconfig6 >/dev/null; then
    kwriteconfig6 --file "${XDG_STATE_HOME:-$HOME/.local/state}/konsolestaterc" \
        --group MainWindow --key State \
        ''
    mkdir -p -- "$state_dir"
    touch -- "$konsole_marker"
    echo "Hid Konsole toolbars"
fi

# ── 0b. fcitx5: theme Samhie cho app Qt ─────────────────────────────────────
# Ô "Unikey (Telex)"/"en" hiện lên khi Ctrl+Space trong app Qt (Konsole,
# Dolphin) do fcitx5-qt vẽ phía app, và fcitx5-qt CHỈ đọc
# ~/.config/fcitx5/conf/classicui.conf — không nhìn /etc/xdg (fcitxtheme.cpp
# của fcitx5-qt 5.1.15, đo 2026-09-30: không có file này thì ô trắng, font
# Sans). Chính fcitx5 thì có đọc /etc/xdg.
# CHÉP chứ không symlink: fcitx5 5.1.22 lưu cấu hình bằng cách ĐI THEO
# symlink (standardpaths_p.h: symlinkTarget) — symlink sang /etc/xdg thì
# người dùng không ghi được, đổi gì trong fcitx5-configtool mất mà không báo
# lỗi (đo trong container 2026-09-30). Cái giá: đổi font/tên theme ở bản sau
# thì tài khoản cũ không nhận. Màu nằm trong /usr/share/fcitx5/themes/Samhie
# nên vẫn tự cập nhật; file chép chỉ giữ tên theme + font.
# Mốc riêng như bước 0; đã có file (người dùng tự chỉnh) thì để nguyên.
fcitx_marker=$state_dir/fcitx5-classicui
fcitx_conf=$config_home/fcitx5/conf/classicui.conf
if [ ! -e "$fcitx_marker" ]; then
    if [ ! -e "$fcitx_conf" ] && [ ! -L "$fcitx_conf" ]; then
        mkdir -p -- "${fcitx_conf%/*}"
        cp -- /etc/xdg/fcitx5/conf/classicui.conf "$fcitx_conf"
        echo "Copied fcitx5 theme config"
    fi
    mkdir -p -- "$state_dir"
    touch -- "$fcitx_marker"
fi

# ── 0c. VS Code: ẩn ba nút cửa sổ tự vẽ ─────────────────────────────────────
# VS Code tự vẽ nút thu nhỏ/phóng to/đóng, nhưng trên Hyprland chỉ nút đóng
# ăn (user 2026-10-02): Hyprland 0.56 bỏ qua yêu cầu thu nhỏ của app
# (CWindow::onUpdateState không đọc requestsMinimize), còn yêu cầu phóng to
# bị luật suppress-maximize-events của samhie.lua chặn. Nút của Samhie nằm
# trên thanh trên → ẩn bộ nút của VS Code (`window.controlsStyle`, có trong
# VS Code 1.140 của image; thanh tiêu đề tự vẽ vẫn giữ: ô tìm kiếm, nút bố cục).
# VS Code không có file mặc định toàn máy, nên CHỈ tạo settings.json khi
# chưa có. Đã có (người dùng đã mở VS Code) thì để nguyên — settings.json
# là JSON có chú thích, sửa bằng máy dễ làm hỏng. Mốc riêng như bước 0.
vscode_marker=$state_dir/vscode-controls
vscode_settings=$config_home/Code/User/settings.json
if [ ! -e "$vscode_marker" ]; then
    if [ ! -e "$vscode_settings" ] && [ ! -L "$vscode_settings" ]; then
        mkdir -p -- "${vscode_settings%/*}"
        printf '{\n    "window.controlsStyle": "hidden"\n}\n' > "$vscode_settings"
        echo "Hid VS Code window controls"
    fi
    mkdir -p -- "$state_dir"
    touch -- "$vscode_marker"
fi

# ── 0d. Edge: bỏ ba nút cửa sổ tự vẽ ────────────────────────────────────────
# Cùng lý do với VS Code ở bước 0c. Edge giấu công tắc "Use system title
# bar" của Chromium khỏi Settings, nhưng vẫn đọc khoá browser.custom_chrome_frame
# trong Preferences: false → Edge nhờ compositor vẽ khung, Hyprland không vẽ
# gì → hết ba nút, dải tab giữ nguyên. Đo trong máy ảo 2026-10-02 (Edge
# Flatpak 154): sửa hồ sơ có sẵn → hết nút; hồ sơ MỚI với Preferences chỉ
# có khoá này → màn chào lần đầu vẫn chạy, không có nút.
# Chỉ tạo khi Edge CHƯA có hồ sơ (chưa mở lần nào) — Preferences do Edge
# tự ghi lại liên tục, sửa file đang có thì có thể bị Edge ghi đè hoặc hỏng.
# Flatpak giữ nguyên thư mục ~/.var/app/<id> có sẵn khi cài/chạy lần đầu.
edge_marker=$state_dir/edge-frame
edge_profile=$HOME/.var/app/com.microsoft.Edge/config/microsoft-edge
if [ ! -e "$edge_marker" ]; then
    if [ ! -e "$edge_profile" ] && [ ! -L "$edge_profile" ]; then
        mkdir -p -- "$edge_profile/Default"
        printf '{"browser":{"custom_chrome_frame":false}}\n' > "$edge_profile/Default/Preferences"
        echo "Hid Edge window controls"
    fi
    mkdir -p -- "$state_dir"
    touch -- "$edge_marker"
fi

# ── 0e. Dolphin: về cỡ mặc định MỖI lần đăng nhập ───────────────────────────
# User 2026-10-05: trong phiên kéo sidebar/cột rộng hẹp tuỳ ý, đăng nhập lại
# thì về mặc định (cửa sổ nổi đã tự về 60% mỗi lần mở — samhie.lua). Không
# có mốc: chạy mọi lần đăng nhập, trước khi Dolphin kịp mở.
#  - Sidebar: độ rộng nằm trong khối State nhị phân (QMainWindow::saveState)
#    của ~/.local/state/dolphinstaterc, nhóm [State]. Khối dưới đây đo trong
#    máy ảo 2026-10-05 (Dolphin 26.08): dock trái 237px = sidebar ~227px mà
#    user đang dùng (mặc định của Dolphin chỉ 134px); dock Folders/Information/
#    Terminal tắt, thanh công cụ hiện. Cái giá: bảng phụ (F7, F11, F4) bật
#    trong phiên cũng tắt lại.
#  - Cột chế độ Details: kéo mép phải tiêu đề cột sát vào thì Dolphin tắt
#    chế độ cột tự động (kitemlistheaderwidget.cpp) và lưu RightPadding=0 +
#    độ rộng cố định — máy ảo: Name 1047px, cửa sổ nổi 60% không còn chỗ cho
#    Size/Modified. Xoá lề hai bên trong dolphinrc và HeaderColumnWidths của
#    kiểu xem chung (Dolphin 24.05+ lưu trong xattr của thư mục
#    view_properties/global; hết chỗ xattr thì vào file .directory trong đó)
#    → cột tự động lại. Kiểu xem riêng từng thư mục (khi tắt kiểu xem chung)
#    thì không đụng.
dolphin_state=${XDG_STATE_HOME:-$HOME/.local/state}/dolphinstaterc
dolphin_props=$data_home/dolphin/view_properties/global
dolphin_xattr='user.kde.fm.viewproperties#1'
if command -v kwriteconfig6 >/dev/null; then
    kwriteconfig6 --file "$dolphin_state" --group State --key State \
        ''
    for key in LeftPadding RightPadding; do
        kwriteconfig6 --file "$config_home/dolphinrc" --group DetailsMode --key "$key" --delete
    done
    if [ -e "$dolphin_props/.directory" ]; then
        kwriteconfig6 --file "$dolphin_props/.directory" --group Dolphin --key HeaderColumnWidths --delete
    fi
fi
if props=$(getfattr --only-values -n "$dolphin_xattr" -- "$dolphin_props" 2>/dev/null) \
    && [[ $props == *HeaderColumnWidths=* ]]; then
    setfattr -n "$dolphin_xattr" -v "$(printf '%s\n' "$props" | grep -v '^HeaderColumnWidths=')" -- "$dolphin_props"
    echo "Reset Dolphin column widths"
fi

# ── 0f. Dolphin Details: cột Modified đứng trước Size ───────────────────────
# User 2026-10-05. Thứ tự mặc định (Name, Size, Modified) viết cứng trong
# Dolphin (ViewProperties::visibleRoles: chưa chọn cột thì thêm size rồi
# modificationtime) và không có bản mặc định toàn máy — kiểu xem chung nằm
# trong xattr của view_properties/global của từng tài khoản (xem 0e). Ghi
# VisibleRoles theo thứ tự mới, MỘT lần mỗi tài khoản (mốc riêng): chỉ khi
# chưa chọn cột cho Details, hoặc đang đúng thứ tự mặc định — tự sắp khác thì
# để nguyên, sau đó đổi gì giữ nấy.
columns_marker=$state_dir/dolphin-columns
if [ ! -e "$columns_marker" ]; then
    props=$(getfattr --only-values -n "$dolphin_xattr" -- "$dolphin_props" 2>/dev/null) \
        || props='[Dolphin]'
    roles=$(printf '%s\n' "$props" | sed -n 's/^VisibleRoles=//p')
    details=$(printf '%s' "$roles" | tr ',' '\n' | grep '^Details_' | paste -sd, -) || true
    new_roles=
    if [ -z "$details" ]; then
        new_roles=${roles:+$roles,}CustomizedDetails,Details_text,Details_modificationtime,Details_size
    elif [ "$details" = Details_text,Details_size,Details_modificationtime ]; then
        new_roles=${roles/Details_size,Details_modificationtime/Details_modificationtime,Details_size}
    fi
    if [ -n "$new_roles" ]; then
        props=$(printf '%s\n' "$props" | grep -v '^VisibleRoles=')
        mkdir -p -- "$dolphin_props"
        setfattr -n "$dolphin_xattr" -v "$props"$'\n'"VisibleRoles=$new_roles" -- "$dolphin_props"
        echo "Put Dolphin's Modified column before Size"
    fi
    mkdir -p -- "$state_dir"
    touch -- "$columns_marker"
fi

# ── 0g. Sidebar: sửa file Places có chú thích đứng trước <xbel> ─────────────
# File mẫu cũ (trước 2026-10-08) có khối chú thích giữa <!DOCTYPE> và <xbel>.
# KBookmarkManager chỉ gỡ khai báo <?xml?> khi nó đứng ngay trước <xbel> →
# lần lưu đầu (Add to Places, ẩn/sửa mục) chèn khai báo thứ hai sau chú
# thích, XML hỏng, lần đọc sau KIO ghi đè bộ mục mặc định của KDE (xem
# usr/share/samhie/user-places.xbel.in). Bỏ mọi chú thích và khai báo thừa
# trước <xbel>; các mục giữ nguyên. Chạy mỗi lần đăng nhập, file không có gì
# trước <xbel> ngoài khai báo + DOCTYPE thì không ghi.
if [ -f "$places" ] && awk '
    /<xbel[ >]/ { found = 1; exit }
    /<!--/ || (/<\?xml/ && decl++) { bad = 1 }
    END { exit !(found && bad) }' "$places"; then
    awk '
        xbel { print; next }
        /<xbel[ >]/ { xbel = 1; print; next }
        comment { if (/-->/) comment = 0; next }
        /<!--/ { if (!/-->/) comment = 1; next }
        /<\?xml/ { if (decl++) next }
        { print }' "$places" > "$places.tmp"
    mv -f -- "$places.tmp" "$places"
    echo "Repaired the comment before <xbel> in $places"
fi

# ── 0h. Kate: bố cục kiểu VS Code + terminal làm tab ────────────────────────
# Kate cất danh sách plugin bật và chỗ của từng panel trong file PHIÊN
# (anonymous.katesession, KConfig::SimpleConfig — không có bản mặc định toàn
# máy, đọc mã Kate 26.08.1). Plugin ngoài danh sách viết cứng của Kate
# (katepluginmanager.cpp) không bao giờ tự bật — nên ghi cho từng tài khoản.
# Chỉ đổi đúng các khoá dưới, giữ mọi thứ khác Kate đã lưu. Mốc riêng: chạy
# một lần; sau đó người dùng kéo panel đi đâu Kate tự nhớ.
#   samhieterminalplugin  terminal làm tab cạnh file, Ctrl+` (kate/)
#   katekonsoleplugin     tắt terminal ở khung dưới — trùng với cái trên
#   cột trái  = Projects (Explorer), Search, Git, Outline như VS Code; Search
#               dời từ khung dưới lên; Documents (danh sách file mở — trùng
#               dải tab) ẩn nút
#   khung dưới = Diagnostics (Problems), Output; ẩn nút Project (thông tin dự án)
kate_marker=$state_dir/kate-layout
kate_session=$data_home/kate/anonymous.katesession
if [ ! -e "$kate_marker" ] && command -v kwriteconfig6 >/dev/null; then
    mkdir -p -- "${kate_session%/*}"
    kate_set() { kwriteconfig6 --file "$kate_session" --group "$1" --key "$2" "$3"; }
    kate_set 'Kate Plugins' samhieterminalplugin true
    kate_set 'Kate Plugins' katekonsoleplugin false
    mdi=Kate-MDI
    kate_set MainWindow0 $mdi-Sidebar-0-Bar-0-TvList \
        kateproject,kate_plugin_katesearch,kateprojectgit,lspclient_symbol_outline,kate_private_plugin_katefiletreeplugin
    kate_set MainWindow0 $mdi-Sidebar-3-Bar-0-TvList diagnostics,output,kateprojectinfo
    # Danh sách trên chỉ được dùng để GIỮ CHỖ theo thứ tự khi có khoá Splitter
    # (số phần tử = số khu trong cột; Sidebar::startRestoreSession) — thiếu
    # thì panel xếp theo thứ tự plugin nạp, Search lên đầu.
    kate_set MainWindow0 $mdi-Sidebar-0-Splitter 100
    kate_set MainWindow0 $mdi-Sidebar-3-Splitter 100
    kate_set MainWindow0 $mdi-ToolView-kate_plugin_katesearch-Position 0
    kate_set MainWindow0 $mdi-ToolView-kateproject-Visible true
    kate_set MainWindow0 $mdi-ToolView-kate_private_plugin_katefiletreeplugin-Show-Button-In-Sidebar false
    kate_set MainWindow0 $mdi-ToolView-kateprojectinfo-Show-Button-In-Sidebar false
    mkdir -p -- "$state_dir"
    touch -- "$kate_marker"
    echo "Set up Kate's VS Code-like layout"
fi

done_version=0
if [ -r "$marker" ]; then
    read -r done_version < "$marker" || true
fi
case $done_version in
    ''|*[!0-9]*) done_version=0 ;;
esac
if [ "$done_version" -ge "$version" ]; then
    exit 0
fi

# /mnt là symlink sang /var/mnt trên Fedora Atomic; lấy đường dẫn thật để
# sidebar và user-dirs.dirs hiện đúng chỗ mount.
storage=$HOME/Storage
if [ -e /mnt/storage ]; then
    storage_mount=$(realpath -- /mnt/storage)
    if ! mountpoint -q -- "$storage_mount"; then
        echo "/mnt/storage is not a mount point, using $storage"
    elif [ ! -w "$storage_mount" ]; then
        echo "Cannot write to $storage_mount (fix with: sudo chown $(id -un): $storage_mount), using $storage"
    else
        storage=$storage_mount
    fi
fi

# Tên XDG  | chỗ của Samhie | chỗ mặc định khi chưa có user-dirs.dirs
#   @ = thư mục Storage, ~ = home, - = tắt (trỏ về chính home — quy ước của
#   xdg-user-dirs cho "không dùng"; Templates/Public hiếm ai dùng)
# (cột cuối là thứ Qt/GLib tự dùng khi file thiếu dòng đó — thư mục Fedora
# hay tạo sẵn, cần nhận ra để dọn nếu rỗng)
layout='DESKTOP     -          Desktop
DOWNLOAD    ~/Download Downloads
DOCUMENTS   @/Docs     Documents
TEMPLATES   -          Templates
MUSIC       @/Music    Music
PICTURES    @/Pictures Pictures
VIDEOS      @/Videos   Videos
PUBLICSHARE -          Public'

resolve() {
    case $1 in
        -) printf '%s' "$HOME" ;;
        '~'/*) printf '%s/%s' "$HOME" "${1#'~'/}" ;;
        @/*) printf '%s/%s' "$storage" "${1#@/}" ;;
    esac
}

# ── 1. Thư mục ──────────────────────────────────────────────────────────────

# File này sinh ra để `source` (xem đầu file do xdg-user-dirs ghi). Chỉ gán
# biến XDG_*_DIR; biến của script viết thường nên không đụng nhau.
if [ -r "$dirs_file" ]; then
    # shellcheck disable=SC1090
    . "$dirs_file"
fi

targets=$(while read -r _ rel _; do resolve "$rel"; echo; done <<< "$layout")

is_target() {
    printf '%s\n' "$targets" | grep -qxF -- "$1"
}

# Thư mục không tồn tại cũng tính là rỗng. $HOME thì không bao giờ rỗng.
# Chỉ có ".directory" cũng là rỗng: Plasma/Dolphin tự ghi file đó (kiểu xem,
# icon) — ~/Desktop của tài khoản Kinoite cũ có sẵn nó (đo trong máy ảo
# 2026-09-29), trước đây làm script tưởng "có file" và giữ Desktop lại.
is_empty_dir() {
    local entries
    [ "$1" != "$HOME" ] || return 1
    [ -e "$1" ] || return 0
    [ -d "$1" ] || return 1
    entries=$(ls -A -- "$1")
    [ -z "$entries" ] || [ "$entries" = .directory ]
}

# Ghi đường dẫn theo cú pháp của user-dirs.dirs: "$HOME/…" hoặc tuyệt đối.
to_dirs_value() {
    local path=$1 prefix=
    if [ "$path" = "$HOME" ]; then
        printf '$HOME'
        return
    fi
    case $path in
        "$HOME"/*) prefix='$HOME/'; path=${path#"$HOME"/} ;;
    esac
    path=${path//\\/\\\\}
    path=${path//\"/\\\"}
    path=${path//\$/\\\$}
    path=${path//\`/\\\`}
    printf '%s%s' "$prefix" "$path"
}

# Storage luôn có, kể cả khi mọi thư mục cũ đều được giữ: sidebar trỏ vào nó.
mkdir -p -- "$storage"

lines=
while read -r name rel stock; do
    var=XDG_${name}_DIR
    current=${!var:-$HOME/$stock}
    target=$(resolve "$rel")

    if [ "$current" = "$target" ]; then
        chosen=$target
    elif [ "$current" = "$HOME" ] || is_empty_dir "$current"; then
        if [ "$current" != "$HOME" ] && [ -d "$current" ] && ! is_target "$current"; then
            rm -f -- "$current/.directory"
            rmdir -- "$current" && echo "Removed empty $current"
        fi
        chosen=$target
    else
        echo "Kept $name at $current (has files)"
        chosen=$current
    fi

    mkdir -p -- "$chosen"
    lines+="XDG_${name}_DIR=\"$(to_dirs_value "$chosen")\""$'\n'
    printf -v "$var" '%s' "$chosen"
done <<< "$layout"

# Ảnh chụp màn hình (phím Print, /usr/libexec/samhie/screenshot) lưu ở đây.
# Tạo sẵn, rỗng cũng để hiện — user chốt 2026-09-29.
mkdir -p -- "$XDG_PICTURES_DIR/Screenshots"

# Giữ nguyên dòng XDG_*_DIR không chuẩn người dùng tự thêm (vd PROJECTS).
extra=
if [ -r "$dirs_file" ]; then
    known=$(printf '%s\n' "$layout" | awk '{ printf "%sXDG_%s_DIR=", (NR > 1 ? "|" : ""), $1 }')
    extra=$(grep -E '^XDG_[A-Z0-9_]+_DIR=' "$dirs_file" | grep -vE "^($known)" || true)
fi

mkdir -p -- "$config_home"
{
    echo '# Thư mục người dùng — cấu trúc Storage của Samhie. "$HOME" = không dùng.'
    echo '# Ghi bởi /usr/libexec/samhie/user-setup ở lần đăng nhập đầu; từ đó file'
    echo '# là của bạn, Samhie không ghi lại nữa — sửa thẳng ở đây, rồi đăng nhập lại.'
    printf '%s' "$lines"
    if [ -n "$extra" ]; then
        printf '%s\n' "$extra"
    fi
} > "$dirs_file.tmp"
mv -f -- "$dirs_file.tmp" "$dirs_file"

# ── 2. Sidebar Places của Dolphin ───────────────────────────────────────────

# file:// URL với mã hoá phần trăm từng byte (tên thư mục có dấu cách, chữ
# Việt, & …). Kết quả chỉ còn ký tự an toàn nên chèn thẳng vào XML được.
file_url() {
    local LC_ALL=C path=$1 out= c i
    for ((i = 0; i < ${#path}; i++)); do
        c=${path:i:1}
        case $c in
            [A-Za-z0-9/._~-]) out+=$c ;;
            *) printf -v c '%%%02X' "'$c"; out+=$c ;;
        esac
    done
    printf 'file://%s' "$out"
}

if [ -r "$places_template" ]; then
    # File cũ (vd Plasma của Kinoite tự tạo trước khi rebase) cất sang bên
    # cạnh chứ không xoá. Không đè bản cất nếu đã có.
    if [ -e "$places" ] && [ ! -e "$places.before-samhie" ]; then
        mv -- "$places" "$places.before-samhie"
        echo "Saved old Dolphin places as $places.before-samhie"
    fi

    xbel=$(< "$places_template")
    # Phần thay thế để trong ngoặc kép: bash 5.2+ coi `&` không trích dẫn là
    # "chuỗi vừa khớp" (patsub_replacement).
    xbel=${xbel//@HOME_URL@/"$(file_url "$HOME")"}
    xbel=${xbel//@STORAGE_URL@/"$(file_url "$storage")"}
    xbel=${xbel//@DOWNLOAD_URL@/"$(file_url "$XDG_DOWNLOAD_DIR")"}

    mkdir -p -- "$data_home"
    printf '%s\n' "$xbel" > "$places.tmp"
    mv -f -- "$places.tmp" "$places"
    echo "Wrote Dolphin places to $places"
fi

mkdir -p -- "$state_dir"
echo "$version" > "$marker"
