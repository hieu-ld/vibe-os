#!/usr/bin/env bash
# Chụp màn hình kiểu Windows (user chốt 2026-09-29):
#   screenshot          Print        — cả màn hình
#   screenshot region   Win+Shift+S  — kéo chọn một vùng (Esc để huỷ)
# Ảnh TỰ LƯU vào <thư mục Pictures>/Screenshots (= Storage/Pictures/
# Screenshots theo cấu trúc của Samhie), đồng thời copy vào clipboard, rồi hiện
# thông báo. Bấm vào thông báo để mở swappy vẽ lên ảnh.
#
# Phần hình kiểu Ubuntu (user chốt 2026-09-29) là hai file Quickshell trong
# /usr/share/samhie/quickshell: screenshot-region.qml (màn hình đứng hình, kéo
# chọn, chỉnh khung, Enter chụp) và screenshot-preview.qml (ảnh thu nhỏ đóng
# khung trắng ~1 s sau khi chụp cả màn hình). Chụp xong có tiếng tách.
#
# swappy không đọc cấu hình hệ thống, chỉ ~/.config/swappy/config, nên chỗ lưu
# ảnh đã vẽ truyền qua biến XDG_DESKTOP_DIR: đọc mã nguồn swappy 1.5.1
# (config.c, get_default_save_dir), nó thử biến này ĐẦU TIÊN. Người dùng tự đặt
# save_dir trong ~/.config/swappy/config thì cái đó thắng. swappy tách biến
# bằng wordexp: đường dẫn có dấu cách thì nó lưu vào $HOME — không mất ảnh.
set -eu

mode=${1:-full}

# Mỗi lúc chỉ một lần chụp: bấm phím hai lần thật nhanh thì hai lớp chọn vùng
# mở chồng lên nhau — lớp trên nhìn xuyên xuống lớp tối của lớp dưới (gặp
# trong máy ảo 2026-09-29; `quickshell -n` không chặn kịp vì cả hai cùng mở
# trong 1 ms). Khoá nhả trước khi chờ thông báo. Tiến trình sống lâu hơn
# script (wl-copy chạy nền giữ clipboard) phải đóng fd 9, không thì giữ khoá.
exec 9>"${XDG_RUNTIME_DIR:-/tmp}/samhie-screenshot.lock"
flock -n 9 || exit 0

dirs_file=${XDG_CONFIG_HOME:-$HOME/.config}/user-dirs.dirs
XDG_PICTURES_DIR=$HOME
if [ -r "$dirs_file" ]; then
    # shellcheck disable=SC1090
    . "$dirs_file"
fi
save_dir=$XDG_PICTURES_DIR/Screenshots
mkdir -p -- "$save_dir"

# Tên theo giờ; chụp hai tấm trong cùng một giây thì thêm -2, -3…
stamp=$(date +%Y-%m-%d_%H-%M-%S)
file=$save_dir/Screenshot_$stamp.png
n=2
while [ -e "$file" ]; do
    file=$save_dir/Screenshot_${stamp}-$n.png
    n=$((n + 1))
done

qml=/usr/share/samhie/quickshell
shutter=/usr/share/sounds/freedesktop/stereo/camera-shutter.oga

play_shutter() {
    # Chạy nền: tiếng kêu không được làm chậm việc lưu ảnh.
    if command -v pw-play >/dev/null; then
        pw-play -- "$shutter" >/dev/null 2>&1 9>&- &
    fi
}

case $mode in
    region)
        # Đông cứng màn hình: chụp nguyên màn hình NGAY, giao diện chọn vùng
        # hiện ảnh này lên. PPM thay PNG: khỏi nén, nhanh hơn; Qt đọc sẵn.
        # Để trong XDG_RUNTIME_DIR (tmpfs, chỉ chủ tài khoản đọc được).
        frozen=$(mktemp --tmpdir="${XDG_RUNTIME_DIR:-/tmp}" samhie-shot.XXXXXX.ppm)
        grim -t ppm -- "$frozen"
        # Giao diện cắt vùng chọn từ ảnh đông, ghi thẳng vào $file. Esc thì
        # không có file: thoát êm, không báo gì.
        SAMHIE_SHOT_FROZEN=$frozen SAMHIE_SHOT_FILE=$file \
            quickshell -p "$qml/screenshot-region.qml" || true
        rm -f -- "$frozen"
        [ -s "$file" ] || exit 0
        play_shutter
        ;;
    full)
        grim -- "$file"
        play_shutter
        ;;
    *)
        echo "usage: $0 [full|region]" >&2
        exit 2
        ;;
esac

wl-copy --type image/png < "$file" 9>&-

if [ "$mode" = full ]; then
    # Đứng ~1,3 s rồi tự thoát; thông báo hiện SAU, khỏi đè lên ảnh xem trước.
    SAMHIE_SHOT_FILE=$file quickshell -p "$qml/screenshot-preview.qml" || true
fi
exec 9>&-

# notify-send có --action thì CHỜ tới khi thông báo đóng: -t cho nó tự tắt sau
# 6 s (thông báo Quickshell báo "hết hạn" khi popup tắt, bản chép vẫn nằm trong
# danh sách của chuông). Bấm vào thông báo = việc "default" → mở swappy.
# Một dòng (user chốt 2026-10-02): dòng tên app đã ghi "Screenshot", ảnh xem
# trước nằm ngay dưới — "Screenshot saved" là thừa.
action=$(notify-send -a Screenshot -i "$file" -t 6000 -A default=Edit \
    "Copied · Click to edit" || true)
if [ "$action" = default ]; then
    XDG_DESKTOP_DIR=$save_dir exec swappy -f "$file"
fi
