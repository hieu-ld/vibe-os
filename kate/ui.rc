<!DOCTYPE gui SYSTEM "kpartgui.dtd">
<gui name="samhiekate" library="samhiekateplugin" version="2">
  <MenuBar>
    <Menu name="file">
      <Action name="samhie_close_folder" group="open_merge"/>
    </Menu>
    <Menu name="samhie_terminal">
      <text>&amp;Terminal</text>
      <Action name="samhie_terminal_new"/>
      <Action name="samhie_terminal_toggle"/>
    </Menu>
  </MenuBar>
</gui>
