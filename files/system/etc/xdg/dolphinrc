# Mặc định toàn máy cho Dolphin. Đè riêng trong ~/.config/dolphinrc — Dolphin
# tự ghi vào file đó khi người dùng đổi trong menu, file này không bị đụng tới.

[PlacesPanel]
# Icon sidebar Places 20px (menu chuột phải chỉ có 16/22/32/48, mặc định 22).
# Khoá là số nguyên tuỳ ý — đọc mã nguồn dolphin_placespanelsettings.kcfg.
# User chốt 2026-09-29 sau khi thử trong máy ảo.
IconSize=20

[General]
# Bỏ nút +/− chọn nhanh ở góc ô khi trỏ chuột — Ctrl+bấm làm được việc đó
# (user chốt 2026-10-04). Khoá: dolphin_generalsettings.kcfg.
ShowSelectionToggle=false
# Dải tab luôn hiện (bản vẽ user), kể cả khi chỉ có 1 tab — mặc định Dolphin
# chỉ hiện khi có từ 2 tab. Nút + ở góc trái dải do style "samhie" thêm.
AlwaysShowTabBar=true
# Mở Dolphin luôn ở thư mục Home (HomeUrl), không mở lại các tab lần trước
# (user 2026-10-04). Tab mới (+, Ctrl+T) cũng mở Home — style "samhie" lo.
RememberOpenedTabs=false

[PreviewSettings]
# Tắt xem trước THƯ MỤC (directorythumbnail: Dolphin vẽ ảnh thu nhỏ của file
# bên trong đè lên icon thư mục — user thấy "lem" ở Pictures, chọn tắt
# 2026-10-04). File ảnh/video vẫn có ảnh thu nhỏ.
# Danh sách = KIO::PreviewJob::defaultPlugins() của image trừ
# directorythumbnail — in bằng chương trình C++ nhỏ trong image e4ebf3d
# (textthumbnail vốn không nằm trong mặc định). Khai Plugins là khai CẢ danh
# sách: image thêm trình tạo ảnh thu nhỏ mới thì phải thêm tên vào đây, không
# thì nó tắt. Người dùng bật lại: Dolphin → Configure → Interface → Previews.
Plugins=exrthumbnail,mobithumbnail,blenderthumbnail,kraorathumbnail,imagethumbnail,jpegthumbnail,opendocumentthumbnail,audiothumbnail,svgthumbnail,ebookthumbnail,comicbookthumbnail,djvuthumbnail,gsthumbnail,windowsimagethumbnail,ffmpegthumbs,cursorthumbnail,rawthumbnail,windowsexethumbnail,ffmpegthumbnailer,gsf-office

[DetailsMode]
# Chế độ Details không mở thư mục con dạng cây (mũi tên ▸): bỏ khoảng trống
# ~50px Dolphin chừa bên trái icon cho mũi tên, icon thẳng hàng với tiêu đề
# cột Name (user chốt 2026-10-05). Khoá: dolphin_detailsmodesettings.kcfg.
ExpandableFolders=false
