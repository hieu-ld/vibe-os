# Samhie — dòng hiện ở tab Details của hộp Properties (Dolphin Alt+Return,
# baloo-widgets 26.08.1 MetadataFilter). false = ẩn. Đọc cascade: người dùng
# bật lại được trong ~/.config/baloofileinformationrc.
#
# Ẩn thêm (user 2026-10-08): Type, Size và ba dòng ngày đã có ở tab General;
# Tags không dùng. Còn lại Rating, Comment và metadata riêng của từng loại
# file (cỡ ảnh, thời lượng nhạc/phim, nguồn tải về…).
#
# [Misc] version = 13 (currentVersion của baloo-widgets): thiếu nó thì lần
# đầu baloo-widgets xoá cả nhóm [Show] trong file người dùng (deleteGroup —
# che luôn file này) rồi ghi lại danh sách mặc định của nó. Vì vậy danh sách
# mặc định đó (initMetaInformationSettings) phải chép vào đây. Lên version mới
# thì so lại danh sách.

[Misc]
version=13

[Show]
# Mặc định của baloo-widgets
width=false
height=false
comment=false
contentSize=false
depends=false
lastModified=false
created=false
contentCreated=false
mimeType=false
url=false
